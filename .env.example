# Copy to .env and adjust. Used by the Prisma CLI and by the app at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gambit?schema=public"

# Secret for hashing visitors' IP addresses into the key their game history is
# stored under (history is per IP, there are no accounts). Required in
# production; any long random string, e.g. `openssl rand -hex 32`. Changing it
# detaches everyone from their existing history.
HISTORY_OWNER_SECRET=""

# Optional. Name of the one request header that carries the real client IP when
# the app sits behind a proxy that sets a dedicated one (x-vercel-forwarded-for,
# cf-connecting-ip, ...). Unset: x-real-ip, then the first x-forwarded-for entry.
# CLIENT_IP_HEADER=""
