# Copy to .env and adjust. Used by the Prisma CLI and by the app at runtime.
# With `docker compose up -d` this works as-is.
DATABASE_URL="postgresql://gambit:gambit@localhost:5432/gambit?schema=public"

# Secret that signs the anonymous visitor cookie each player's game history is
# kept under (there are no accounts) and hashes it into the stored owner key.
# Required in production; any long random string, e.g. `openssl rand -hex 32`.
# Changing it detaches everyone from their existing history.
HISTORY_OWNER_SECRET=""
