// Finished games played against Stockfish, kept per visitor (see ownerKey).
// One row per game; the PGN is the
// full record (moves, players, result), the other columns exist so the history
// list can be shown and filtered without parsing it.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlayerColor {
  WHITE
  BLACK
}

enum GameResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
}

enum Termination {
  CHECKMATE
  STALEMATE
  DRAW
  TIMEOUT
  RESIGNATION
}

model Game {
  /// Generated by the browser when a game starts, so saving the same game twice
  /// (or saving it again after an undo) updates one row instead of adding two.
  id                    String      @id
  /// When the game finished.
  playedAt              DateTime    @default(now())
  pgn                   String
  plies                 Int
  /// The side the human played.
  humanColor            PlayerColor
  result                GameResult
  termination           Termination
  /// An id from app/lib/engine-levels.ts, e.g. "standard".
  engineLevel           String
  /// 0 means the game was untimed.
  clockMinutes          Int
  clockIncrementSeconds Int
  /// Who the game belongs to: a keyed hash of the visitor id in their cookie
  /// (see app/lib/visitor-id.ts), never the id itself. Every query filters on it.
  /// Games saved before this column existed have "" and are listed for nobody.
  ownerKey              String      @default("")

  @@index([ownerKey, playedAt(sort: Desc), id(sort: Desc)])
  @@map("games")
}
