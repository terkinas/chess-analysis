generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One game played against the engine. The id is generated in the browser when
/// the game starts, so saving the same game twice (when it ends, and again from
/// "Analyze") updates one row instead of adding two.
model Game {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  white      String
  black      String
  /// "w" or "b": the side the human played.
  humanColor String
  /// PGN result: "1-0", "0-1", "1/2-1/2", or "*" while unfinished.
  result     String
  /// "checkmate" | "stalemate" | "draw" | "timeout" | "resignation"; null while unfinished.
  termination String?
  levelId    String
  /// 0 means untimed.
  clockMinutes          Int
  clockIncrementSeconds Int

  plies Int
  /// SAN moves in order; the source of truth. `pgn` is the exported form.
  moves String[]
  pgn   String

  @@index([createdAt(sort: Desc)])
}
